{
  "name": "shopify-app-review-guard",
  "version": "0.1.1",
  "description": "Offline, deterministic preflight checks for Shopify App Store and production readiness.",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "shopify-app-review-guard": "src/cli.js" },
  "files": ["src", "action.yml", "dist", "docs", "README.md", "LICENSE", "CHANGELOG.md", "SECURITY.md"],
  "scripts": {
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage",
    "lint": "node --check src/cli.js && node --check src/analyzer.js && node --check src/output.js && node --check src/action.js",
    "typecheck": "node --check src/analyzer.js",
    "build": "node scripts/build-action.mjs",
    "check": "node src/cli.js check --format human --fail-on none",
    "package:smoke": "npm pack --dry-run",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "repository": { "type": "git", "url": "git+https://github.com/efegokdemir/shopify-app-review-guard.git" },
  "homepage": "https://github.com/efegokdemir/shopify-app-review-guard",
  "bugs": { "url": "https://github.com/efegokdemir/shopify-app-review-guard/issues" },
  "license": "MIT",
  "keywords": ["shopify", "shopify-app", "app-review", "static-analysis", "security", "compliance", "webhooks", "github-action", "npm"],
  "author": "Efe Gökdemir",
  "publishConfig": { "provenance": true }
}
